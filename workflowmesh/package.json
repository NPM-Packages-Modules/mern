{
  "name": "@mr-aftab-ahmad-khan/workflowmesh",
  "version": "0.1.0",
  "description": "workflowmesh — Smart async workflow engine: chained steps, retries, backoff, and optional rollback for readable Node.js orchestration.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "async",
    "mern-packages",
    "merndev",
    "nodejs",
    "npm-pm",
    "observability",
    "orchestration",
    "pipeline",
    "retry",
    "rollback",
    "typescript",
    "workflow",
    "workflowmesh"
  ],
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Aftab Ahmad Khan (https://github.com/aftab-ahmad-khan-dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NPM-Packages-Modules/mern.git",
    "directory": "workflowmesh"
  },
  "bugs": {
    "url": "https://github.com/NPM-Packages-Modules/mern/issues"
  },
  "homepage": "https://github.com/NPM-Packages-Modules/mern/tree/main/workflowmesh",
  "publishConfig": {
    "access": "public"
  }
}
